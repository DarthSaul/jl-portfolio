# Nuxt app config. Copy to web/.env — Nuxt loads .env from this directory.
# All of these are public by design: they ship in the browser bundle.

NUXT_PUBLIC_SANITY_PROJECT_ID=c3808h1v
NUXT_PUBLIC_SANITY_DATASET=development
NUXT_PUBLIC_SANITY_API_VERSION=2026-07-31

# Where /admin redirects. Empty until `npm run deploy` in studio/ claims a hostname.
# Full origin including scheme, e.g. https://joan-lebow.sanity.studio
# While empty, /admin returns a 503 with a legible message rather than failing oddly.
NUXT_PUBLIC_SANITY_STUDIO_URL=
