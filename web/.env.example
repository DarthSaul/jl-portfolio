# Next app config. Copy to web/.env — Next loads .env from this directory.
#
# All of these are SERVER-SIDE. None carries a NEXT_PUBLIC_ prefix, and that is not a style
# choice: nothing in the browser talks to Sanity. The one client-side read the site has —
# "load more" on /shots/all — goes through app/api/photos, so the project id, the dataset and
# the API version never reach the bundle. `import 'server-only'` in src/sanity/client.ts makes
# a regression a build error rather than a leak.
#
# There are no defaults. An unset value throws at module scope and fails the build, which is
# the same refusal studio/dataset.ts makes and for the same reason: both wrong answers fail
# quietly, and a deploy silently reading the wrong dataset is the hazard worth failing loudly on.

SANITY_PROJECT_ID=c3808h1v
SANITY_DATASET=development
SANITY_API_VERSION=2026-07-31

# Where /admin redirects. Full origin including scheme, no trailing slash.
# Read at request time by app/admin/route.ts. If left empty, /admin returns a 503 with a
# legible message rather than failing oddly.
SANITY_STUDIO_URL=https://joanatstake.sanity.studio
