# Repo-root env, for scripts/ only. Copy to .env at the repo root.
#
# The app and the Studio have their own templates — see web/.env.example and
# studio/.env.example. Each tool loads .env from its own directory, so the three
# files are separate on purpose rather than duplicated.

# Write access for scripts/ (seeding stock content into the development dataset).
# NEVER referenced in app code: not in web/app/, not in web/server/, not in
# nuxt.config.ts, not in runtime config. See CLAUDE.md.
SANITY_WRITE_TOKEN=
