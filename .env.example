# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Sanity client, read by the Nuxt app -------------------------------------
# Public by design: these end up in the browser bundle.
NUXT_PUBLIC_SANITY_PROJECT_ID=
NUXT_PUBLIC_SANITY_DATASET=development
NUXT_PUBLIC_SANITY_API_VERSION=2026-07-31

# Where /admin redirects. Empty until `npm run studio:deploy` claims a hostname.
# Full origin, including scheme, e.g. https://jl-portfolio.sanity.studio
NUXT_PUBLIC_SANITY_STUDIO_URL=

# --- Sanity CLI and Studio bundle --------------------------------------------
# Used by `sanity dev`, `sanity deploy`, `sanity schema extract`, `sanity typegen`.
# Same project; the dataset is baked into the Studio bundle at deploy time, so set
# this to `production` when deploying and `development` when running locally.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=development

# --- Scripts only ------------------------------------------------------------
# Write access for scripts/ (seeding). NEVER referenced in app code: not in app/,
# not in server/, not in nuxt.config.ts, not in runtime config.
SANITY_WRITE_TOKEN=
